<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
MODELLO: TD24 - FATTURA DIFFERITA
=============================================================================
I dati costanti di Amazon sono precompilati. NON modificarli.
Compila tutti i campi contrassegnati dalle parentesi quadre [].
Rimuovi tutti i commenti prima di inviare allo SDI.
=============================================================================
QUANDO USARLO: Stai fatturando merci già consegnate
accompagnate da un DDT (Documento di Trasporto).
Il TD24 ti permette di raggruppare più consegne dello
stesso mese in un'unica fattura.
Deve essere emessa entro il 15 del mese successivo
al mese di consegna.
=============================================================================
-->
<p:FatturaElettronica versione="FPR12"
xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">
<FatturaElettronicaHeader>
<!-- === DATI TRASMISSIONE === -->
<DatiTrasmissione>
<IdTrasmittente>
<IdPaese>IT</IdPaese>
<IdCodice>[IL_TUO_CODICE_FISCALE]</IdCodice>
</IdTrasmittente>
<ProgressivoInvio>[NUMERO_PROGRESSIVO_INVIO]</ProgressivoInvio>
<FormatoTrasmissione>SDI11</FormatoTrasmissione>
<!-- NON MODIFICARE: Codice destinatario Amazon -->
<CodiceDestinatario>[CODICE_SDI]</CodiceDestinatario>
<!-- NON MODIFICARE: PEC Amazon -->
<PECDestinatario>amazoneu@legalmail.it</PECDestinatario>
</DatiTrasmissione>
<!-- === DATI CEDENTE (LA TUA AZIENDA) === -->
<CedentePrestatore>
<DatiAnagrafici>
<IdFiscaleIVA>
<IdPaese>IT</IdPaese>
<IdCodice>[LA_TUA_PARTITA_IVA_SENZA_PREFISSO_IT]</IdCodice>
</IdFiscaleIVA>
<Anagrafica>
<Denominazione>[NOME_DELLA_TUA_AZIENDA]</Denominazione>
</Anagrafica>
<RegimeFiscale>[IL_TUO_CODICE_REGIME_FISCALE]</RegimeFiscale>
<!-- Comune: RF01 = Ordinario -->
</DatiAnagrafici>
<Sede>
<Indirizzo>[IL_TUO_INDIRIZZO]</Indirizzo>
<NumeroCivico>[IL_TUO_NUMERO_CIVICO]</NumeroCivico>
<CAP>[IL_TUO_CAP]</CAP>
<Comune>[LA_TUA_CITTA]</Comune>
<Nazione>IT</Nazione>
</Sede>
</CedentePrestatore>
<!-- === DATI CESSIONARIO (AMAZON) - NON MODIFICARE NESSUN CAMPO === -->
<CessionarioCommittente>
<DatiAnagrafici>
<IdFiscaleIVA>
<IdPaese>IT</IdPaese>
<IdCodice>08973230967</IdCodice>
</IdFiscaleIVA>
<Anagrafica>
<Denominazione>AMAZON EU SARL, SUCCURSALE ITALIANA</Denominazione>
</Anagrafica>
</DatiAnagrafici>
<Sede>
<Indirizzo>VIALE MONTE GRAPPA</Indirizzo>
<NumeroCivico>3/5</NumeroCivico>
<CAP>20124</CAP>
<Comune>MILANO</Comune>
<Nazione>IT</Nazione>
</Sede>
</CessionarioCommittente>
</FatturaElettronicaHeader>
<FatturaElettronicaBody>
<!-- === DATI GENERALI DOCUMENTO === -->
<DatiGenerali>
<DatiGeneraliDocumento>
<!-- TD24 = Fattura Differita -->
<TipoDocumento>TD24</TipoDocumento>
<Divisa>EUR</Divisa>
<Data>[AAAA-MM-GG]</Data>
<!-- Data fattura. Deve essere emessa entro il 15 del
mese SUCCESSIVO a quello di consegna.
Esempio: Merce consegnata a Marzo 2026 ->
La data fattura deve essere entro il 2026-04-15 -->
<Numero>[IL_TUO_NUMERO_FATTURA_UNIVOCO]</Numero>
<!-- Deve essere univoco per l'anno di riferimento -->
<ImportoTotaleDocumento>[IMPORTO_TOTALE_IVA_INCLUSA]</ImportoTotaleDocumento>
</DatiGeneraliDocumento>
<!-- === RIFERIMENTO ORDINE DI ACQUISTO (PO) === -->
<!-- Copia il numero PO ESATTAMENTE come ricevuto da Amazon -->
<!-- I PO Retail = 8 caratteri (es. 6HAEVIIY) -->
<DatiOrdineAcquisto>
<RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
<!-- Aggiungi un RiferimentoNumeroLinea per ogni articolo coperto da questo PO -->
<IdDocumento>[NUMERO_PO_AMAZON]</IdDocumento>
</DatiOrdineAcquisto>
<!-- Se hai PIU' PO in una fattura, aggiungi un altro blocco: -->
<!--
<DatiOrdineAcquisto>
<RiferimentoNumeroLinea>[NUMERI_LINEA_PER_QUESTO_PO]</RiferimentoNumeroLinea>
<IdDocumento>[SECONDO_NUMERO_PO_AMAZON]</IdDocumento>
</DatiOrdineAcquisto>
-->
<!-- ========================================================= -->
<!-- RIFERIMENTO DDT - OBBLIGATORIO PER TD24                   -->
<!-- Questa è la base legale per la fattura differita.         -->
<!-- Senza di esso, utilizza invece il TD01.                   -->
<!-- ========================================================= -->
<DatiDDT>
<NumeroDDT>[IL_TUO_NUMERO_DDT]</NumeroDDT>
<!-- Il numero del documento di trasporto -->
<DataDDT>[AAAA-MM-GG]</DataDDT>
<!-- La data del documento di trasporto -->
<RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
<!-- Aggiungi un RiferimentoNumeroLinea per ogni articolo coperto da questo DDT -->
</DatiDDT>
<!-- Se hai PIU' DDT in una singola fattura
(raggruppando più consegne), aggiungi un altro blocco: -->
<!--
<DatiDDT>
<NumeroDDT>[SECONDO_NUMERO_DDT]</NumeroDDT>
<DataDDT>[AAAA-MM-GG]</DataDDT>
<RiferimentoNumeroLinea>[NUMERI_LINEA_PER_QUESTO_DDT]</RiferimentoNumeroLinea>
</DatiDDT>
-->
</DatiGenerali>
<!-- === DETTAGLIO LINEE === -->
<DatiBeniServizi>
<!-- Ripeti questo blocco per OGNI linea prodotto -->
<DettaglioLinee>
<NumeroLinea>1</NumeroLinea>
<!-- *** IDENTIFICAZIONE PRODOTTO - CRITICO *** -->
<!-- Senza questo, la fattura SARA' rifiutata -->
<!-- Trova il codice sul PO Amazon per ogni articolo -->
<!-- Valori CodiceTipo accettati: EAN, ASIN, UPC, SKU, ISBN,
JAN, EN, SSC, ISSN, MATERIAL NUMBER, MINSAN -->
<!-- ATTENZIONE: Se il codice inizia con 0, includi lo zero iniziale! -->
<CodiceArticolo>
<CodiceTipo>[EAN_O_ASIN]</CodiceTipo>
<CodiceValore>[CODICE_PRODOTTO_DAL_PO_AMAZON]</CodiceValore>
</CodiceArticolo>
<Descrizione>[DESCRIZIONE_PRODOTTO]</Descrizione>
<Quantita>[QUANTITA]</Quantita>
<PrezzoUnitario>[PREZZO_UNITARIO]</PrezzoUnitario>
<PrezzoTotale>[TOTALE_LINEA_IMPONIBILE]</PrezzoTotale>
<AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
<!-- Aliquote IVA Italiane: 22.00, 10.00, 5.00, 4.00 -->
</DettaglioLinee>
<!-- === CODICI ADDEBITO (se applicabili) === -->
<!-- Usa per contributi CONAI, RAEE, SIAE: -->
<!--
<DettaglioLinee>
<NumeroLinea>[NUMERO_LINEA_SUCCESSIVO]</NumeroLinea>
<TipoCessionePrestazione>C</TipoCessionePrestazione>
<CodiceArticolo>
<CodiceTipo>SSC</CodiceTipo>
<CodiceValore>SH</CodiceValore>
</CodiceArticolo>
<Descrizione>SPECIAL HANDLING</Descrizione>
<Quantita>1.00</Quantita>
<PrezzoUnitario>[IMPORTO_ADDEBITO]</PrezzoUnitario>
<PrezzoTotale>[IMPORTO_ADDEBITO]</PrezzoTotale>
<AliquotaIVA>0.00</AliquotaIVA>
<Natura>N1</Natura>
</DettaglioLinee>
-->
<!-- === RIEPILOGO IVA === -->
<!-- Un blocco DatiRiepilogo per ogni aliquota IVA utilizzata -->
<DatiRiepilogo>
<AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
<!-- es. 22.00 -->
<ImponibileImporto>[IMPORTO_NETTO_PER_QUESTA_ALIQUOTA]</ImponibileImporto>
<!-- Totale delle linee prodotto prima dell'IVA con questa aliquota -->
<Imposta>[IMPORTO_IVA]</Imposta>
<!-- Importo IVA = ImponibileImporto x AliquotaIVA / 100 -->
</DatiRiepilogo>
</DatiBeniServizi>
<!-- === DATI PAGAMENTO === -->
<DatiPagamento>
<CondizioniPagamento>TP02</CondizioniPagamento>
<!-- TP02 = Pagamento completo -->
<DettaglioPagamento>
<ModalitaPagamento>MP05</ModalitaPagamento>
<!-- MP05 = Bonifico bancario -->
<ImportoPagamento>[IMPORTO_TOTALE_IVA_INCLUSA]</ImportoPagamento>
<!-- Deve corrispondere a ImportoTotaleDocumento -->
</DettaglioPagamento>
</DatiPagamento>
</FatturaElettronicaBody>
</p:FatturaElettronica>
```</Cedente>