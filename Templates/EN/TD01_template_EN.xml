<!--
 =====================================================
 OBELUS TOOLKIT — Template: TD01 - INVOICE (FATTURA)
 github.com/obd1973/Obelus
 =====================================================
 HOW TO USE THIS TEMPLATE:
 1. Open Obelus Mentor first to understand each field.
 2. Fill in all fields marked with [ ] brackets.
 3. Remove ALL comments (lines starting with <!--)
    before submitting to SDI.
 4. Validate the completed file with Obelus before
    submitting.

 AMAZON CONSTANTS: Fields marked DO NOT CHANGE are
 pre-filled with Amazon's required exact values.
 Modifying them will cause rejection.
 =====================================================
-->
<p:FatturaElettronica versione="FPR12"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">

    <FatturaElettronicaHeader>

        <!-- =========================================
             TRANSMISSION DATA
             ========================================= -->
        <DatiTrasmissione>
            <IdTrasmittente>
                <IdPaese>IT</IdPaese>
                <IdCodice>[YOUR_FISCAL_CODE]</IdCodice>
                <!-- Your company fiscal code (codice fiscale), without IT prefix -->
            </IdTrasmittente>
            <ProgressivoInvio>[SEQUENTIAL_TRANSMISSION_NUMBER]</ProgressivoInvio>
            <!-- A sequential number you assign to each transmission, e.g. 00001 -->
            <FormatoTrasmissione>SDI11</FormatoTrasmissione>
            <!-- DO NOT CHANGE -->
            <CodiceDestinatario>[SDI_ROUTING_CODE]</CodiceDestinatario>
            <!-- DO NOT CHANGE — Use the correct code for your channel:
                 Retail (Vendor Central): XR6XN0E
                 Dropship:                ERI9GSW
                 Advantage:               ZDHP2W8 -->
            <PECDestinatario>amazoneu@legalmail.it</PECDestinatario>
            <!-- DO NOT CHANGE -->
        </DatiTrasmissione>

        <!-- =========================================
             SUPPLIER DATA — YOUR COMPANY
             Fill in all fields with your own details.
             ========================================= -->
        <CedentePrestatore>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>[YOUR_VAT_NUMBER_WITHOUT_IT_PREFIX]</IdCodice>
                    <!-- Example: if your VAT is IT12345678901, enter 12345678901 -->
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>[YOUR_COMPANY_NAME]</Denominazione>
                    <!-- Exact legal name as registered with the tax authority -->
                </Anagrafica>
                <RegimeFiscale>[YOUR_TAX_REGIME_CODE]</RegimeFiscale>
                <!-- Most common: RF01 = Ordinario
                     Other codes: RF02 Minimi, RF04 Agricoltura, RF19 Forfettario -->
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>[YOUR_STREET_ADDRESS]</Indirizzo>
                <NumeroCivico>[YOUR_STREET_NUMBER]</NumeroCivico>
                <CAP>[YOUR_POSTCODE]</CAP>
                <Comune>[YOUR_CITY]</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CedentePrestatore>

        <!-- =========================================
             BUYER DATA — AMAZON
             DO NOT CHANGE ANY OF THESE VALUES.
             ========================================= -->
        <CessionarioCommittente>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>08973230967</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>AMAZON EU SARL, SUCCURSALE ITALIANA</Denominazione>
                </Anagrafica>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>VIALE MONTE GRAPPA</Indirizzo>
                <NumeroCivico>3/5</NumeroCivico>
                <CAP>20124</CAP>
                <Comune>MILANO</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CessionarioCommittente>

    </FatturaElettronicaHeader>

    <FatturaElettronicaBody>

        <!-- =========================================
             GENERAL DOCUMENT DATA
             ========================================= -->
        <DatiGenerali>
            <DatiGeneraliDocumento>
                <TipoDocumento>TD01</TipoDocumento>
                <!-- DO NOT CHANGE -->
                <Divisa>EUR</Divisa>
                <!-- DO NOT CHANGE -->
                <Data>[YYYY-MM-DD]</Data>
                <!-- Invoice date. Format example: 2026-05-06 -->
                <Numero>[YOUR_UNIQUE_INVOICE_NUMBER]</Numero>
                <!-- Must be unique per calendar year.
                     Do not reuse numbers. Do not resubmit old numbers. -->
                <ImportoTotaleDocumento>[TOTAL_AMOUNT_INCLUDING_VAT]</ImportoTotaleDocumento>
                <!-- Total with VAT included. Must match ImportoPagamento below exactly. -->
            </DatiGeneraliDocumento>

            <!-- =========================================
                 PURCHASE ORDER REFERENCE
                 Copy the PO number EXACTLY as shown in
                 Vendor Central. Do not retype manually.
                 Retail POs:   8 characters  e.g. 6HAEVIIY
                 Dropship POs: 9 characters  e.g. ABCdeF12G
                 ========================================= -->
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
                <!-- Add one RiferimentoNumeroLinea per line item covered by this PO -->
                <IdDocumento>[AMAZON_PO_NUMBER]</IdDocumento>
            </DatiOrdineAcquisto>

            <!-- If you have MULTIPLE POs in one invoice, duplicate the block above:
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>[LINE_NUMBERS_FOR_THIS_PO]</RiferimentoNumeroLinea>
                <IdDocumento>[SECOND_AMAZON_PO_NUMBER]</IdDocumento>
            </DatiOrdineAcquisto>
            -->

            <!-- =========================================
                 DELIVERY DOCUMENT (DDT) — Optional
                 Recommended when a DDT exists.
                 ========================================= -->
            <DatiDDT>
                <NumeroDDT>[YOUR_DDT_NUMBER]</NumeroDDT>
                <DataDDT>[YYYY-MM-DD]</DataDDT>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
            </DatiDDT>

        </DatiGenerali>

        <!-- =========================================
             LINE ITEMS
             Repeat the DettaglioLinee block for each
             product line on the invoice.
             ========================================= -->
        <DatiBeniServizi>

            <DettaglioLinee>
                <NumeroLinea>1</NumeroLinea>

                <!-- PRODUCT CODE — REQUIRED. Without this the invoice will be rejected.
                     Find the code on the Amazon Purchase Order for each item.
                     Accepted CodiceTipo values:
                       EAN, ASIN, UPC, SKU, ISBN, JAN, EN, SSC, ISSN,
                       MATERIAL NUMBER, MINSAN
                     WARNING: If the code starts with 0, keep the leading zero.
                     Excel may strip it — always check. -->
                <CodiceArticolo>
                    <CodiceTipo>[EAN_OR_ASIN]</CodiceTipo>
                    <CodiceValore>[PRODUCT_CODE_FROM_AMAZON_PO]</CodiceValore>
                </CodiceArticolo>

                <Descrizione>[PRODUCT_DESCRIPTION]</Descrizione>
                <Quantita>[QUANTITY]</Quantita>
                <!-- Format: decimal with 2 places, e.g. 10.00 -->
                <PrezzoUnitario>[UNIT_PRICE]</PrezzoUnitario>
                <!-- Net unit price before VAT, e.g. 25.50 -->
                <PrezzoTotale>[LINE_TOTAL_BEFORE_VAT]</PrezzoTotale>
                <!-- Quantity x Unit price, e.g. 255.00 -->
                <AliquotaIVA>[VAT_RATE]</AliquotaIVA>
                <!-- Italian VAT rates: 22.00 / 10.00 / 5.00 / 4.00
                     Format must include decimals: 22.00 not 22 -->
            </DettaglioLinee>

            <!-- CHARGE CODES — Use for CONAI, RAEE, SIAE contributions if applicable:
            <DettaglioLinee>
                <NumeroLinea>[NEXT_LINE_NUMBER]</NumeroLinea>
                <TipoCessionePrestazione>C</TipoCessionePrestazione>
                <CodiceArticolo>
                    <CodiceTipo>SSC</CodiceTipo>
                    <CodiceValore>SH</CodiceValore>
                </CodiceArticolo>
                <Descrizione>SPECIAL HANDLING</Descrizione>
                <Quantita>1.00</Quantita>
                <PrezzoUnitario>[CHARGE_AMOUNT]</PrezzoUnitario>
                <PrezzoTotale>[CHARGE_AMOUNT]</PrezzoTotale>
                <AliquotaIVA>0.00</AliquotaIVA>
                <Natura>N1</Natura>
            </DettaglioLinee>
            -->

            <!-- FREIGHT — Use for shipping costs if applicable:
            <DettaglioLinee>
                <NumeroLinea>[NEXT_LINE_NUMBER]</NumeroLinea>
                <TipoCessionePrestazione>C</TipoCessionePrestazione>
                <CodiceArticolo>
                    <CodiceTipo>SSC</CodiceTipo>
                    <CodiceValore>FC</CodiceValore>
                </CodiceArticolo>
                <Descrizione>FREIGHT</Descrizione>
                <Quantita>1.00</Quantita>
                <PrezzoUnitario>[FREIGHT_AMOUNT]</PrezzoUnitario>
                <PrezzoTotale>[FREIGHT_AMOUNT]</PrezzoTotale>
                <AliquotaIVA>0.00</AliquotaIVA>
                <Natura>N1</Natura>
            </DettaglioLinee>
            -->

            <!-- =========================================
                 TAX SUMMARY
                 One DatiRiepilogo block per VAT rate used.
                 If you used both 22% and 10%, add two blocks.
                 ========================================= -->
            <DatiRiepilogo>
                <AliquotaIVA>[VAT_RATE]</AliquotaIVA>
                <!-- e.g. 22.00 -->
                <ImponibileImporto>[NET_AMOUNT_AT_THIS_RATE]</ImponibileImporto>
                <!-- Sum of all line totals before VAT at this rate -->
                <Imposta>[VAT_AMOUNT]</Imposta>
                <!-- VAT amount = ImponibileImporto x AliquotaIVA / 100 -->
            </DatiRiepilogo>

        </DatiBeniServizi>

        <!-- =========================================
             PAYMENT DATA
             ========================================= -->
        <DatiPagamento>
            <CondizioniPagamento>TP02</CondizioniPagamento>
            <!-- DO NOT CHANGE — TP02 = Complete payment -->
            <DettaglioPagamento>
                <ModalitaPagamento>MP05</ModalitaPagamento>
                <!-- DO NOT CHANGE — MP05 = Bank transfer -->
                <ImportoPagamento>[TOTAL_AMOUNT_INCLUDING_VAT]</ImportoPagamento>
                <!-- Must match ImportoTotaleDocumento exactly, to the cent -->
            </DettaglioPagamento>
        </DatiPagamento>

    </FatturaElettronicaBody>

</p:FatturaElettronica>

<!--
 =====================================================
 CHECKLIST BEFORE SUBMITTING
 =====================================================
 [ ] Amazon entity name is exactly:
     AMAZON EU SARL, SUCCURSALE ITALIANA
 [ ] CodiceDestinatario matches your channel:
     Retail: XR6XN0E  |  Dropship: ERI9GSW  |  Advantage: ZDHP2W8
 [ ] PEC is: amazoneu@legalmail.it
 [ ] Amazon VAT is: 08973230967 (without IT prefix)
 [ ] Every line item has a CodiceArticolo with a valid
     EAN or ASIN copied from the Amazon PO
 [ ] Leading zeros in product codes are preserved
 [ ] Invoice number is unique for this calendar year
 [ ] ImportoPagamento matches ImportoTotaleDocumento
 [ ] All comments have been removed from the file
 [ ] File validated with Obelus before submission
 =====================================================
-->
