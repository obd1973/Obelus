<!--
 =====================================================
 OBELUS TOOLKIT — Template: TD01 - FATTURA
 github.com/obd1973/Obelus
 =====================================================
 COME USARE QUESTO TEMPLATE:
 1. Apri prima Obelus Mentor per capire ogni campo.
 2. Compila tutti i campi indicati con [ ] parentesi.
 3. Rimuovi TUTTI i commenti (righe che iniziano con
    <!--) prima di inviare allo SDI.
 4. Valida il file completato con Obelus prima di
    inviarlo.

 COSTANTI AMAZON: I campi contrassegnati con
 NON MODIFICARE sono precompilati con i valori
 esatti richiesti da Amazon.
 Modificarli causerà il rifiuto della fattura.
 =====================================================
-->
<p:FatturaElettronica versione="FPR12"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">

    <FatturaElettronicaHeader>

        <!-- =========================================
             DATI DI TRASMISSIONE
             ========================================= -->
        <DatiTrasmissione>
            <IdTrasmittente>
                <IdPaese>IT</IdPaese>
                <IdCodice>[TUO_CODICE_FISCALE]</IdCodice>
                <!-- Il codice fiscale della tua azienda, senza prefisso IT -->
            </IdTrasmittente>
            <ProgressivoInvio>[NUMERO_PROGRESSIVO_TRASMISSIONE]</ProgressivoInvio>
            <!-- Un numero sequenziale che assegni a ogni trasmissione, es. 00001 -->
            <FormatoTrasmissione>SDI11</FormatoTrasmissione>
            <!-- NON MODIFICARE -->
            <CodiceDestinatario>[CODICE_SDI_AMAZON]</CodiceDestinatario>
            <!-- NON MODIFICARE — Usa il codice corretto per il tuo canale:
                 Retail (Vendor Central): XR6XN0E
                 Dropship:                ERI9GSW
                 Advantage:               ZDHP2W8 -->
            <PECDestinatario>amazoneu@legalmail.it</PECDestinatario>
            <!-- NON MODIFICARE -->
        </DatiTrasmissione>

        <!-- =========================================
             DATI FORNITORE — LA TUA AZIENDA
             Compila tutti i campi con i tuoi dati.
             ========================================= -->
        <CedentePrestatore>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>[TUA_PARTITA_IVA_SENZA_PREFISSO_IT]</IdCodice>
                    <!-- Esempio: se la tua P.IVA è IT12345678901, inserisci 12345678901 -->
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>[RAGIONE_SOCIALE_TUA_AZIENDA]</Denominazione>
                    <!-- Nome legale esatto come registrato in camera di commercio -->
                </Anagrafica>
                <RegimeFiscale>[CODICE_REGIME_FISCALE]</RegimeFiscale>
                <!-- Il più comune: RF01 = Ordinario
                     Altri codici: RF02 Minimi, RF04 Agricoltura, RF19 Forfettario -->
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>[VIA_O_PIAZZA]</Indirizzo>
                <NumeroCivico>[NUMERO_CIVICO]</NumeroCivico>
                <CAP>[CAP]</CAP>
                <Comune>[COMUNE]</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CedentePrestatore>

        <!-- =========================================
             DATI ACQUIRENTE — AMAZON
             NON MODIFICARE NESSUNO DI QUESTI VALORI.
             ========================================= -->
        <CessionarioCommittente>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>08973230967</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>AMAZON EU SARL, SUCCURSALE ITALIANA</Denominazione>
                </Anagrafica>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>VIALE MONTE GRAPPA</Indirizzo>
                <NumeroCivico>3/5</NumeroCivico>
                <CAP>20124</CAP>
                <Comune>MILANO</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CessionarioCommittente>

    </FatturaElettronicaHeader>

    <FatturaElettronicaBody>

        <!-- =========================================
             DATI GENERALI DOCUMENTO
             ========================================= -->
        <DatiGenerali>
            <DatiGeneraliDocumento>
                <TipoDocumento>TD01</TipoDocumento>
                <!-- NON MODIFICARE -->
                <Divisa>EUR</Divisa>
                <!-- NON MODIFICARE -->
                <Data>[AAAA-MM-GG]</Data>
                <!-- Data della fattura. Esempio: 2026-05-06 -->
                <Numero>[TUO_NUMERO_FATTURA_UNIVOCO]</Numero>
                <!-- Deve essere univoco per anno solare.
                     Non riutilizzare numeri già usati.
                     Non reinviare vecchie fatture con lo stesso numero. -->
                <ImportoTotaleDocumento>[IMPORTO_TOTALE_IVA_INCLUSA]</ImportoTotaleDocumento>
                <!-- Totale comprensivo di IVA. Deve corrispondere esattamente
                     all'ImportoPagamento indicato in fondo. -->
            </DatiGeneraliDocumento>

            <!-- =========================================
                 RIFERIMENTO ORDINE DI ACQUISTO (PO)
                 Copia il numero PO ESATTAMENTE come
                 appare in Vendor Central. Non riscriverlo
                 a mano.
                 PO Retail:   8 caratteri  es. 6HAEVIIY
                 PO Dropship: 9 caratteri  es. ABCdeF12G
                 ========================================= -->
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
                <!-- Aggiungi un RiferimentoNumeroLinea per ogni riga coperta da questo PO -->
                <IdDocumento>[NUMERO_PO_AMAZON]</IdDocumento>
            </DatiOrdineAcquisto>

            <!-- Se hai PIÙ PO nella stessa fattura, duplica il blocco qui sopra:
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>[NUMERI_RIGA_PER_QUESTO_PO]</RiferimentoNumeroLinea>
                <IdDocumento>[SECONDO_NUMERO_PO_AMAZON]</IdDocumento>
            </DatiOrdineAcquisto>
            -->

            <!-- =========================================
                 DOCUMENTO DI TRASPORTO (DDT) — Facoltativo
                 Consigliato quando esiste un DDT.
                 ========================================= -->
            <DatiDDT>
                <NumeroDDT>[TUO_NUMERO_DDT]</NumeroDDT>
                <DataDDT>[AAAA-MM-GG]</DataDDT>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
            </DatiDDT>

        </DatiGenerali>

        <!-- =========================================
             RIGHE FATTURA
             Ripeti il blocco DettaglioLinee per ogni
             prodotto presente in fattura.
             ========================================= -->
        <DatiBeniServizi>

            <DettaglioLinee>
                <NumeroLinea>1</NumeroLinea>

                <!-- CODICE PRODOTTO — OBBLIGATORIO.
                     Senza questo campo la fattura verrà rifiutata.
                     Trova il codice sull'Ordine di Acquisto Amazon per ogni articolo.
                     Valori CodiceTipo accettati:
                       EAN, ASIN, UPC, SKU, ISBN, JAN, EN, SSC, ISSN,
                       MATERIAL NUMBER, MINSAN
                     ATTENZIONE: Se il codice inizia con 0, mantieni lo zero iniziale.
                     Excel potrebbe eliminarlo — controlla sempre. -->
                <CodiceArticolo>
                    <CodiceTipo>[EAN_O_ASIN]</CodiceTipo>
                    <CodiceValore>[CODICE_PRODOTTO_DAL_PO_AMAZON]</CodiceValore>
                </CodiceArticolo>

                <Descrizione>[DESCRIZIONE_PRODOTTO]</Descrizione>
                <Quantita>[QUANTITA]</Quantita>
                <!-- Formato: decimale con 2 cifre, es. 10.00 -->
                <PrezzoUnitario>[PREZZO_UNITARIO]</PrezzoUnitario>
                <!-- Prezzo netto per unità senza IVA, es. 25.50 -->
                <PrezzoTotale>[TOTALE_RIGA_SENZA_IVA]</PrezzoTotale>
                <!-- Quantità x Prezzo unitario, es. 255.00 -->
                <AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
                <!-- Aliquote IVA italiane: 22.00 / 10.00 / 5.00 / 4.00
                     Il formato deve includere i decimali: 22.00 non 22 -->
            </DettaglioLinee>

            <!-- CODICI ADDEBITO — Usa per contributi CONAI, RAEE, SIAE se applicabili:
            <DettaglioLinee>
                <NumeroLinea>[NUMERO_RIGA_SUCCESSIVO]</NumeroLinea>
                <TipoCessionePrestazione>C</TipoCessionePrestazione>
                <CodiceArticolo>
                    <CodiceTipo>SSC</CodiceTipo>
                    <CodiceValore>SH</CodiceValore>
                </CodiceArticolo>
                <Descrizione>SPECIAL HANDLING</Descrizione>
                <Quantita>1.00</Quantita>
                <PrezzoUnitario>[IMPORTO_ADDEBITO]</PrezzoUnitario>
                <PrezzoTotale>[IMPORTO_ADDEBITO]</PrezzoTotale>
                <AliquotaIVA>0.00</AliquotaIVA>
                <Natura>N1</Natura>
            </DettaglioLinee>
            -->

            <!-- SPESE DI TRASPORTO — Usa per costi di spedizione se applicabili:
            <DettaglioLinee>
                <NumeroLinea>[NUMERO_RIGA_SUCCESSIVO]</NumeroLinea>
                <TipoCessionePrestazione>C</TipoCessionePrestazione>
                <CodiceArticolo>
                    <CodiceTipo>SSC</CodiceTipo>
                    <CodiceValore>FC</CodiceValore>
                </CodiceArticolo>
                <Descrizione>FREIGHT</Descrizione>
                <Quantita>1.00</Quantita>
                <PrezzoUnitario>[IMPORTO_TRASPORTO]</PrezzoUnitario>
                <PrezzoTotale>[IMPORTO_TRASPORTO]</PrezzoTotale>
                <AliquotaIVA>0.00</AliquotaIVA>
                <Natura>N1</Natura>
            </DettaglioLinee>
            -->

            <!-- =========================================
                 RIEPILOGO IVA
                 Un blocco DatiRiepilogo per ogni aliquota
                 IVA utilizzata in fattura. Se hai usato
                 sia il 22% che il 10%, aggiungi due blocchi.
                 ========================================= -->
            <DatiRiepilogo>
                <AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
                <!-- es. 22.00 -->
                <ImponibileImporto>[IMPONIBILE_A_QUESTA_ALIQUOTA]</ImponibileImporto>
                <!-- Somma dei totali riga senza IVA a questa aliquota -->
                <Imposta>[IMPORTO_IVA]</Imposta>
                <!-- Importo IVA = ImponibileImporto x AliquotaIVA / 100 -->
            </DatiRiepilogo>

        </DatiBeniServizi>

        <!-- =========================================
             DATI PAGAMENTO
             ========================================= -->
        <DatiPagamento>
            <CondizioniPagamento>TP02</CondizioniPagamento>
            <!-- NON MODIFICARE — TP02 = Pagamento completo -->
            <DettaglioPagamento>
                <ModalitaPagamento>MP05</ModalitaPagamento>
                <!-- NON MODIFICARE — MP05 = Bonifico bancario -->
                <ImportoPagamento>[IMPORTO_TOTALE_IVA_INCLUSA]</ImportoPagamento>
                <!-- Deve corrispondere esattamente all'ImportoTotaleDocumento, al centesimo -->
            </DettaglioPagamento>
        </DatiPagamento>

    </FatturaElettronicaBody>

</p:FatturaElettronica>

