<?xml version="1.0" encoding="UTF-8"?>
<!--
 =====================================================
 OBELUS TOOLKIT — Template: TD04 - CREDIT NOTE
 github.com/obd1973/Obelus
 =====================================================
 HOW TO USE THIS TEMPLATE:
 1. Open Obelus Mentor first to understand each field.
 2. Fill in all fields marked with [ ] brackets.
 3. Remove ALL comments before submitting to SDI.
 4. Validate with Obelus before submitting.

 WHEN TO USE TD04:
 Use this template to cancel or partially reduce a
 previously issued invoice (TD01). A credit note must
 reference the original invoice number in
 DatiFattureCollegate. Without this reference the
 credit note will not auto-clear in Amazon's OFA system
 and payment will not be released.

 IMPORTANT: The total amount of this credit note must
 match the original invoice amount exactly if you are
 cancelling in full, or the partial amount if reducing.
 =====================================================
-->
<p:FatturaElettronica versione="FPR12"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">

    <FatturaElettronicaHeader>

        <!-- =========================================
             TRANSMISSION DATA
             ========================================= -->
        <DatiTrasmissione>
            <IdTrasmittente>
                <IdPaese>IT</IdPaese>
                <IdCodice>[YOUR_FISCAL_CODE]</IdCodice>
            </IdTrasmittente>
            <ProgressivoInvio>[SEQUENTIAL_TRANSMISSION_NUMBER]</ProgressivoInvio>
            <FormatoTrasmissione>SDI11</FormatoTrasmissione>
            <!-- DO NOT CHANGE -->
            <CodiceDestinatario>[SDI_ROUTING_CODE]</CodiceDestinatario>
            <!-- DO NOT CHANGE — Use the correct code for your channel:
                 Retail (Vendor Central): XR6XN0E
                 Dropship:                ERI9GSW
                 Advantage:               ZDHP2W8 -->
            <PECDestinatario>amazoneu@legalmail.it</PECDestinatario>
            <!-- DO NOT CHANGE -->
        </DatiTrasmissione>

        <!-- =========================================
             SUPPLIER DATA — YOUR COMPANY
             ========================================= -->
        <CedentePrestatore>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>[YOUR_VAT_NUMBER_WITHOUT_IT_PREFIX]</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>[YOUR_COMPANY_NAME]</Denominazione>
                </Anagrafica>
                <RegimeFiscale>[YOUR_TAX_REGIME_CODE]</RegimeFiscale>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>[YOUR_STREET_ADDRESS]</Indirizzo>
                <NumeroCivico>[YOUR_STREET_NUMBER]</NumeroCivico>
                <CAP>[YOUR_POSTCODE]</CAP>
                <Comune>[YOUR_CITY]</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CedentePrestatore>

        <!-- =========================================
             BUYER DATA — AMAZON — DO NOT CHANGE
             ========================================= -->
        <CessionarioCommittente>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>08973230967</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>AMAZON EU SARL, SUCCURSALE ITALIANA</Denominazione>
                </Anagrafica>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>VIALE MONTE GRAPPA</Indirizzo>
                <NumeroCivico>3/5</NumeroCivico>
                <CAP>20124</CAP>
                <Comune>MILANO</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CessionarioCommittente>

    </FatturaElettronicaHeader>

    <FatturaElettronicaBody>

        <!-- =========================================
             GENERAL DOCUMENT DATA
             ========================================= -->
        <DatiGenerali>
            <DatiGeneraliDocumento>
                <TipoDocumento>TD04</TipoDocumento>
                <!-- DO NOT CHANGE -->
                <Divisa>EUR</Divisa>
                <!-- DO NOT CHANGE -->
                <Data>[YYYY-MM-DD]</Data>
                <!-- Date of this credit note -->
                <Numero>[YOUR_UNIQUE_CREDIT_NOTE_NUMBER]</Numero>
                <!-- Must be unique. Use your own numbering sequence for credit notes. -->
                <ImportoTotaleDocumento>[TOTAL_CREDIT_AMOUNT_INCLUDING_VAT]</ImportoTotaleDocumento>
                <!-- Enter as a POSITIVE number. e.g. 1220.00
                     Must match ImportoPagamento below exactly. -->

                <!-- =========================================
                     REASON CODE — REQUIRED FOR OFA CLEARING
                     One of the three accepted codes must appear
                     in at least one Causale field.
                     PQV = Price/quantity variance
                     PPV = Purchase price variance
                     QPD = Early payment discount
                     ========================================= -->
                <Causale>PQV - [BRIEF_DESCRIPTION_OF_REASON]</Causale>
                <!-- Example: PQV - Price adjustment for invoice [ORIGINAL_INVOICE_NUMBER] -->

            </DatiGeneraliDocumento>

            <!-- =========================================
                 ORIGINAL INVOICE REFERENCE — REQUIRED
                 This links the credit note to the invoice
                 it is cancelling or reducing.
                 Without this, OFA auto-clearing will fail
                 and payment will not be released.
                 ========================================= -->
            <DatiFattureCollegate>
                <IdDocumento>[ORIGINAL_INVOICE_NUMBER]</IdDocumento>
                <!-- The invoice number (Numero) from the original TD01 -->
                <Data>[ORIGINAL_INVOICE_DATE_YYYY-MM-DD]</Data>
                <!-- Date of the original invoice -->
            </DatiFattureCollegate>

            <!-- =========================================
                 PURCHASE ORDER REFERENCE
                 Same PO as on the original invoice.
                 ========================================= -->
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
                <IdDocumento>[AMAZON_PO_NUMBER]</IdDocumento>
            </DatiOrdineAcquisto>

        </DatiGenerali>

        <!-- =========================================
             LINE ITEMS
             Mirror the lines from the original invoice
             that this credit note covers. Amounts should
             be positive — the TD04 type signals credit.
             ========================================= -->
        <DatiBeniServizi>

            <DettaglioLinee>
                <NumeroLinea>1</NumeroLinea>
                <CodiceArticolo>
                    <CodiceTipo>[EAN_OR_ASIN]</CodiceTipo>
                    <CodiceValore>[PRODUCT_CODE_FROM_AMAZON_PO]</CodiceValore>
                </CodiceArticolo>
                <Descrizione>[PRODUCT_DESCRIPTION]</Descrizione>
                <Quantita>[QUANTITY]</Quantita>
                <PrezzoUnitario>[UNIT_PRICE]</PrezzoUnitario>
                <PrezzoTotale>[LINE_TOTAL_BEFORE_VAT]</PrezzoTotale>
                <AliquotaIVA>[VAT_RATE]</AliquotaIVA>
            </DettaglioLinee>

            <!-- =========================================
                 TAX SUMMARY
                 ========================================= -->
            <DatiRiepilogo>
                <AliquotaIVA>[VAT_RATE]</AliquotaIVA>
                <ImponibileImporto>[NET_CREDIT_AMOUNT_AT_THIS_RATE]</ImponibileImporto>
                <Imposta>[VAT_AMOUNT]</Imposta>
            </DatiRiepilogo>

        </DatiBeniServizi>

        <!-- =========================================
             PAYMENT DATA
             ========================================= -->
        <DatiPagamento>
            <CondizioniPagamento>TP02</CondizioniPagamento>
            <!-- DO NOT CHANGE -->
            <DettaglioPagamento>
                <ModalitaPagamento>MP05</ModalitaPagamento>
                <!-- DO NOT CHANGE -->
                <ImportoPagamento>[TOTAL_CREDIT_AMOUNT_INCLUDING_VAT]</ImportoPagamento>
                <!-- Must match ImportoTotaleDocumento exactly -->
            </DettaglioPagamento>
        </DatiPagamento>

    </FatturaElettronicaBody>

</p:FatturaElettronica>

<!--
 =====================================================
 CHECKLIST BEFORE SUBMITTING — TD04 CREDIT NOTE
 =====================================================
 [ ] TipoDocumento is TD04
 [ ] DatiFattureCollegate contains the correct original
     invoice number in IdDocumento
 [ ] Causale contains PQV, PPV, or QPD
 [ ] Amazon entity name is exactly:
     AMAZON EU SARL, SUCCURSALE ITALIANA
 [ ] CodiceDestinatario matches your channel
 [ ] PEC is: amazoneu@legalmail.it
 [ ] Amazon VAT is: 08973230967
 [ ] Every line item has a valid EAN or ASIN
 [ ] ImportoPagamento matches ImportoTotaleDocumento
 [ ] All comments removed from the file
 [ ] File validated with Obelus before submission
 =====================================================
-->
