<!--
 =====================================================
 OBELUS TOOLKIT — Template: TD04 - NOTA DI CREDITO
 github.com/obd1973/Obelus
 =====================================================
 COME USARE QUESTO TEMPLATE:
 1. Apri prima Obelus Mentor per capire ogni campo.
 2. Compila tutti i campi indicati con [ ] parentesi.
 3. Rimuovi TUTTI i commenti prima di inviare allo SDI.
 4. Valida il file con Obelus prima di inviarlo.

 QUANDO USARE TD04:
 Usa questo template per annullare o ridurre
 parzialmente una fattura già emessa (TD01).
 La nota di credito deve fare riferimento al numero
 della fattura originale in DatiFattureCollegate.
 Senza questo riferimento la nota di credito non
 verrà compensata automaticamente nel sistema OFA
 di Amazon e il pagamento non verrà sbloccato.

 IMPORTANTE: L'importo totale di questa nota di
 credito deve corrispondere esattamente all'importo
 della fattura originale in caso di annullamento
 totale, oppure all'importo parziale da ridurre.
 =====================================================
-->
<p:FatturaElettronica versione="FPR12"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">

    <FatturaElettronicaHeader>

        <!-- =========================================
             DATI DI TRASMISSIONE
             ========================================= -->
        <DatiTrasmissione>
            <IdTrasmittente>
                <IdPaese>IT</IdPaese>
                <IdCodice>[TUO_CODICE_FISCALE]</IdCodice>
            </IdTrasmittente>
            <ProgressivoInvio>[NUMERO_PROGRESSIVO_TRASMISSIONE]</ProgressivoInvio>
            <FormatoTrasmissione>SDI11</FormatoTrasmissione>
            <!-- NON MODIFICARE -->
            <CodiceDestinatario>[CODICE_SDI_AMAZON]</CodiceDestinatario>
            <!-- NON MODIFICARE — Usa il codice corretto per il tuo canale:
                 Retail (Vendor Central): XR6XN0E
                 Dropship:                ERI9GSW
                 Advantage:               ZDHP2W8 -->
            <PECDestinatario>amazoneu@legalmail.it</PECDestinatario>
            <!-- NON MODIFICARE -->
        </DatiTrasmissione>

        <!-- =========================================
             DATI FORNITORE — LA TUA AZIENDA
             ========================================= -->
        <CedentePrestatore>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>[TUA_PARTITA_IVA_SENZA_PREFISSO_IT]</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>[RAGIONE_SOCIALE_TUA_AZIENDA]</Denominazione>
                </Anagrafica>
                <RegimeFiscale>[CODICE_REGIME_FISCALE]</RegimeFiscale>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>[VIA_O_PIAZZA]</Indirizzo>
                <NumeroCivico>[NUMERO_CIVICO]</NumeroCivico>
                <CAP>[CAP]</CAP>
                <Comune>[COMUNE]</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CedentePrestatore>

        <!-- =========================================
             DATI ACQUIRENTE — AMAZON — NON MODIFICARE
             ========================================= -->
        <CessionarioCommittente>
            <DatiAnagrafici>
                <IdFiscaleIVA>
                    <IdPaese>IT</IdPaese>
                    <IdCodice>08973230967</IdCodice>
                </IdFiscaleIVA>
                <Anagrafica>
                    <Denominazione>AMAZON EU SARL, SUCCURSALE ITALIANA</Denominazione>
                </Anagrafica>
            </DatiAnagrafici>
            <Sede>
                <Indirizzo>VIALE MONTE GRAPPA</Indirizzo>
                <NumeroCivico>3/5</NumeroCivico>
                <CAP>20124</CAP>
                <Comune>MILANO</Comune>
                <Nazione>IT</Nazione>
            </Sede>
        </CessionarioCommittente>

    </FatturaElettronicaHeader>

    <FatturaElettronicaBody>

        <!-- =========================================
             DATI GENERALI DOCUMENTO
             ========================================= -->
        <DatiGenerali>
            <DatiGeneraliDocumento>
                <TipoDocumento>TD04</TipoDocumento>
                <!-- NON MODIFICARE -->
                <Divisa>EUR</Divisa>
                <!-- NON MODIFICARE -->
                <Data>[AAAA-MM-GG]</Data>
                <!-- Data di emissione di questa nota di credito -->
                <Numero>[TUO_NUMERO_NOTA_CREDITO_UNIVOCO]</Numero>
                <!-- Deve essere univoco. Usa la tua sequenza numerica per le note di credito. -->
                <ImportoTotaleDocumento>[IMPORTO_TOTALE_CREDITO_IVA_INCLUSA]</ImportoTotaleDocumento>
                <!-- Inserisci come numero POSITIVO. es. 1220.00
                     Deve corrispondere esattamente all'ImportoPagamento in fondo. -->

                <!-- =========================================
                     CODICE CAUSALE — OBBLIGATORIO PER OFA
                     Uno dei tre codici accettati deve essere
                     presente in almeno un campo Causale.
                     PQV = Variazione prezzo/quantità
                     PPV = Variazione prezzo di acquisto
                     QPD = Sconto per pagamento anticipato
                     ========================================= -->
                <Causale>PQV - [BREVE_DESCRIZIONE_MOTIVO]</Causale>
                <!-- Esempio: PQV - Rettifica prezzo fattura [NUMERO_FATTURA_ORIGINALE] -->

            </DatiGeneraliDocumento>

            <!-- =========================================
                 RIFERIMENTO FATTURA ORIGINALE — OBBLIGATORIO
                 Collega questa nota di credito alla fattura
                 che stai annullando o riducendo.
                 Senza questo riferimento la compensazione
                 automatica OFA non avverrà e il pagamento
                 non verrà sbloccato.
                 ========================================= -->
            <DatiFattureCollegate>
                <IdDocumento>[NUMERO_FATTURA_ORIGINALE]</IdDocumento>
                <!-- Il numero fattura (Numero) della TD01 originale -->
                <Data>[DATA_FATTURA_ORIGINALE_AAAA-MM-GG]</Data>
                <!-- Data della fattura originale -->
            </DatiFattureCollegate>

            <!-- =========================================
                 RIFERIMENTO ORDINE DI ACQUISTO
                 Stesso PO della fattura originale.
                 ========================================= -->
            <DatiOrdineAcquisto>
                <RiferimentoNumeroLinea>1</RiferimentoNumeroLinea>
                <IdDocumento>[NUMERO_PO_AMAZON]</IdDocumento>
            </DatiOrdineAcquisto>

        </DatiGenerali>

        <!-- =========================================
             RIGHE NOTA DI CREDITO
             Rispecchia le righe della fattura originale
             coperte da questa nota di credito.
             Gli importi devono essere positivi —
             il tipo TD04 indica già che è un credito.
             ========================================= -->
        <DatiBeniServizi>

            <DettaglioLinee>
                <NumeroLinea>1</NumeroLinea>
                <CodiceArticolo>
                    <CodiceTipo>[EAN_O_ASIN]</CodiceTipo>
                    <CodiceValore>[CODICE_PRODOTTO_DAL_PO_AMAZON]</CodiceValore>
                </CodiceArticolo>
                <Descrizione>[DESCRIZIONE_PRODOTTO]</Descrizione>
                <Quantita>[QUANTITA]</Quantita>
                <PrezzoUnitario>[PREZZO_UNITARIO]</PrezzoUnitario>
                <PrezzoTotale>[TOTALE_RIGA_SENZA_IVA]</PrezzoTotale>
                <AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
            </DettaglioLinee>

            <!-- =========================================
                 RIEPILOGO IVA
                 ========================================= -->
            <DatiRiepilogo>
                <AliquotaIVA>[ALIQUOTA_IVA]</AliquotaIVA>
                <ImponibileImporto>[IMPONIBILE_CREDITO_A_QUESTA_ALIQUOTA]</ImponibileImporto>
                <Imposta>[IMPORTO_IVA]</Imposta>
            </DatiRiepilogo>

        </DatiBeniServizi>

        <!-- =========================================
             DATI PAGAMENTO
             ========================================= -->
        <DatiPagamento>
            <CondizioniPagamento>TP02</CondizioniPagamento>
            <!-- NON MODIFICARE -->
            <DettaglioPagamento>
                <ModalitaPagamento>MP05</ModalitaPagamento>
                <!-- NON MODIFICARE -->
                <ImportoPagamento>[IMPORTO_TOTALE_CREDITO_IVA_INCLUSA]</ImportoPagamento>
                <!-- Deve corrispondere esattamente all'ImportoTotaleDocumento -->
            </DettaglioPagamento>
        </DatiPagamento>

    </FatturaElettronicaBody>

</p:FatturaElettronica>

<!--
 =====================================================
 CHECKLIST PRIMA DI INVIARE — TD04 NOTA DI CREDITO
 =====================================================
 [ ] TipoDocumento è TD04
 [ ] DatiFattureCollegate contiene il numero corretto
     della fattura originale in IdDocumento
 [ ] Causale contiene PQV, PPV o QPD
 [ ] La ragione sociale Amazon è esattamente:
     AMAZON EU SARL, SUCCURSALE ITALIANA
 [ ] Il CodiceDestinatario corrisponde al tuo canale
 [ ] La PEC è: amazoneu@legalmail.it
 [ ] La P.IVA Amazon è: 08973230967
 [ ] Ogni riga ha un EAN o ASIN valido
 [ ] ImportoPagamento corrisponde a ImportoTotaleDocumento
 [ ] Tutti i commenti sono stati rimossi dal file
 [ ] Il file è stato validato con Obelus prima dell'invio
 =====================================================
-->
